{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["points", "to_verify"],
  "properties": {
    "document_mode": {"type": "string", "enum": ["summary", "transcript", "municipal"]},
    "generation_diagnostics": {"type": "object"},
    "experimental_summary": {"type":"object","additionalProperties":false,
      "required":["run_id","workspace_id","artifact_sha256","input_sha256"],"properties":{
        "run_id":{"type":"string","format":"uuid"},"workspace_id":{"type":"string","format":"uuid"},
        "artifact_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "input_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "information_registry": {"type":"object","additionalProperties":false,
      "required":["revision_id","content_sha256","information_ids"],"properties":{
        "revision_id":{"type":"string","minLength":1},"content_sha256":{"type":"string","minLength":64,"maxLength":64},
        "information_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}}}},
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "summary", "sources", "vote_id"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "summary": {"type": "string", "minLength": 1, "maxLength": 10000},
          "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "vote_id": {"type": ["string", "null"]}
          ,"claims": {"type": "array", "items": {"type": "object"}},
          "narrative": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,
            "required":["text","claim_ids","machine_verdict"],"properties":{
              "text":{"type":"string","minLength":1,"maxLength":10000},
              "claim_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
              "template":{"type":"string"},"voice_bindings":{"type":"object","additionalProperties":{"type":"string"}},
              "relation":{"type":"string"},"implicit_speaker":{"type":"string"},"machine_verdict":{"type":"string"}}}}
        }
      }
    },
    "to_verify": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
